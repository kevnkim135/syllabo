# Copy to .env and fill in. Never commit .env.

# Claude API key (https://console.anthropic.com). Leave empty to run with mock data.
ANTHROPIC_API_KEY=

# Model used for lesson generation.
ANTHROPIC_MODEL=claude-sonnet-5-5

# API server port (Vite proxies /api here).
PORT=8787

# Set to 1 to force mock responses even when a key is set (saves credits while building UI).
MOCK_LLM=0

# Mock mode only: simulated model latency in ms (randomized 0.5x-1.5x) to rehearse loading states.
MOCK_DELAY_MS=0
